{
  "name": "@birmarket/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:api": "tsx src/smoke-test.ts",
    "test:catalog": "tsx src/catalog-test.ts",
    "test:settings": "tsx src/settings-test.ts",
    "test:settings-operations": "tsx src/settings-operations-test.ts",
    "test:orders": "tsx src/orders-test.ts",
    "test:milestone": "npm run test:catalog && npm run test:settings && npm run test:settings-operations && npm run test:orders",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
